# Obtén tu clave en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Quién recibe los mensajes del formulario (por defecto: contact@dgm.cloud)
CONTACT_TO_EMAIL=contact@dgm.cloud

# Remitente verificado en Resend (tras verificar dominio dgm.cloud usa algo como):
# CONTACT_FROM_EMAIL=DGM Cloud <contact@dgm.cloud>
# En pruebas sin dominio verificado Resend permite solo onboarding@resend.dev:
CONTACT_FROM_EMAIL=DGM Cloud <onboarding@resend.dev>
